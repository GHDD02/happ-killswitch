# Watcher mode: Automatically sync timezone & geo when VPN IP changes
run_watcher() {
    check_root
    echo -e "${C_CYAN}${C_BOLD}[*] Starting Happ Shield Watcher daemon...${C_RESET}"
    echo -e "    Monitoring VPN endpoint changes every 15s. Press Ctrl+C to stop.\n"
    
    local LAST_IP=""
    while true; do
        CURRENT_IP=$(curl -4 -s --max-time 4 https://ifconfig.me 2>/dev/null || curl -4 -s --max-time 4 https://api.ipify.org 2>/dev/null || true)
        if [ -n "$CURRENT_IP" ] && [ "$CURRENT_IP" != "$LAST_IP" ]; then
            echo -e "${C_YELLOW}[!] IP change detected:${C_RESET} ${LAST_IP:-Initial} -> ${C_GREEN}${CURRENT_IP}${C_RESET}"
            spoof_identity 0
            LAST_IP="$CURRENT_IP"
        fi
        sleep 15
    done
}

