        echo -e "🔒  Kill Switch:         ${C_GREEN}${C_BOLD}[ ACTIVE - 100% ISOLATION ]${C_RESET}"
    else
        echo -e "⚠️   Kill Switch:         ${C_RED}${C_BOLD}[ DISABLED - NETWORK OPEN ]${C_RESET}"
    fi

    echo -n "⚙️   Autostart:           "
    systemctl is-enabled happ-killswitch.service 2>/dev/null || echo "disabled"

    echo -n "🛡️   Browser Protection:  "
    if [ -f "/etc/opt/chrome/policies/managed/happ_shield.json" ]; then
        echo -e "${C_GREEN}Active (Chrome, Brave, Edge, Firefox hardened)${C_RESET}"
    else
        echo -e "${C_YELLOW}Not Installed${C_RESET}"
    fi

    echo -n "📍  GeoClue2 GPS Mock:   "
    if [ -f "/etc/geolocation" ] && [ -f "/etc/geoclue/conf.d/99-happ-spoof.conf" ]; then
        echo -e "${C_GREEN}Active ($(head -n 2 /etc/geolocation | tr '\n' ' '))${C_RESET}"
    else
        echo -e "${C_YELLOW}Not Configured${C_RESET}"
    fi

    spoof_identity 0
}

# Turn Off
turn_off() {
    check_root
    systemctl stop happ-killswitch-cgroup.service 2>/dev/null || true
    if /usr/sbin/nft delete table inet happkill 2>/dev/null; then
        echo -e "\n${C_GREEN}${C_BOLD}[✓] Kill Switch DISABLED${C_RESET} — Network firewall filter removed, traffic unblocked.\n"
    else
        echo -e "\n${C_YELLOW}[!] Kill Switch was already disabled.${C_RESET}\n"
    fi
}

# Install command
do_install() {
    check_root
    echo -e "${C_CYAN}${C_BOLD}[*] Installing Happ Bulletproof Kill Switch...${C_RESET}"

    # Install binary
    cp "$0" /usr/local/bin/happ-killswitch
    chmod 755 /usr/local/bin/happ-killswitch

    # Setup environment & group
    setup_environment

    # Install systemd service
    cat > /etc/systemd/system/happ-killswitch.service <<'EOF'
[Unit]
Description=Happ VPN Bulletproof Kill Switch
DefaultDependencies=no
After=systemd-modules-load.service
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/happ-killswitch on
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
EOF

    # Install watcher service
    cat > /etc/systemd/system/happ-killswitch-watcher.service <<'EOF'
[Unit]
Description=Happ Shield Geo/Timezone Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/happ-killswitch watch
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
EOF

    # Install bash completion
    mkdir -p /etc/bash_completion.d 2>/dev/null || true
    cat > /etc/bash_completion.d/happ-killswitch <<'EOF'
_happ_killswitch() {
    local cur prev words cword
    _init_completion || return
    local commands="on off status refresh spoof watch lan-on lan-off install uninstall version help"
    if [[ ${cword} -eq 1 ]]; then
        COMPREPLY=( $(compgen -W "${commands}" -- ${cur}) )
    fi
}
complete -F _happ_killswitch happ-killswitch
EOF

    systemctl daemon-reload
    echo -e "${C_GREEN}${C_BOLD}[✓] Installation complete!${C_RESET}"
    echo -e "    Binary:      /usr/local/bin/happ-killswitch"
    echo -e "    Run command: sudo happ-killswitch on\n"
}

# Uninstall command
do_uninstall() {
    check_root
    echo -e "${C_YELLOW}${C_BOLD}[*] Uninstalling Happ Kill Switch...${C_RESET}"
    turn_off

    systemctl disable --now happ-killswitch.service 2>/dev/null || true
    systemctl disable --now happ-killswitch-watcher.service 2>/dev/null || true
    rm -f /etc/systemd/system/happ-killswitch*.service
    rm -f /etc/happ-killswitch.nft /etc/happ-killswitch.lan /etc/happ-geo-profile.json
    rm -f /etc/geoclue/conf.d/99-happ-spoof.conf /etc/geolocation
    rm -f /etc/opt/chrome/policies/managed/happ_shield.json
    rm -f /etc/chromium/policies/managed/happ_shield.json
    rm -f /etc/brave/policies/managed/happ_shield.json
    rm -f /etc/opt/edge/policies/managed/happ_shield.json
    rm -f /etc/bash_completion.d/happ-killswitch
    rm -f /usr/local/bin/happ-killswitch
    systemctl daemon-reload

    echo -e "${C_GREEN}${C_BOLD}[✓] Happ Kill Switch successfully uninstalled.${C_RESET}\n"
}

# Help text
show_help() {
    cat <<EOF

${C_BOLD}Happ VPN Bulletproof Kill Switch & Identity Shield v${VERSION}${C_RESET}

${C_BOLD}USAGE:${C_RESET}
    happ-killswitch [COMMAND] [OPTIONS]
    sudo happ-killswitch [COMMAND]

${C_BOLD}COMMANDS:${C_RESET}
    ${C_GREEN}on${C_RESET}           Activate Kill Switch, browser shields, and spoof identity.
    ${C_RED}off${C_RESET}          Deactivate Kill Switch and restore direct network access.
    ${C_CYAN}status${C_RESET}       Show current protection, active public IP, and spoofed persona.
    ${C_YELLOW}spoof${C_RESET}        Re-synchronize system timezone, GPS coordinates, and address.
    ${C_BLUE}refresh${C_RESET}      Refresh firewall whitelist and re-sync geo profile.
    ${C_CYAN}watch${C_RESET}        Start background watcher daemon to auto-sync on IP changes.
    ${C_YELLOW}lan-on${C_RESET}       Allow direct local network access (192.168.x.x, 10.x.x.x, NAS).
    ${C_YELLOW}lan-off${C_RESET}      Block local network traffic (100% strict VPN tunnel).
    ${C_BOLD}install${C_RESET}      Install binary, systemd units, and bash completion.
    ${C_RED}uninstall${C_RESET}    Remove all rules, policies, and files cleanly.
    ${C_BOLD}version${C_RESET}      Display version information.
    ${C_BOLD}help${C_RESET}         Display this help message.

${C_BOLD}OPTIONS:${C_RESET}
    --json       Output status formatted as JSON (for status command).
    -h, --help   Show this help message.

EOF
}

# Entrypoint router
case "${1:-status}" in
    on)
        check_root
        write_conf
        systemctl enable happ-killswitch.service >/dev/null 2>&1 || true
        systemctl enable happ-killswitch-cgroup.service >/dev/null 2>&1 || true
        spoof_identity 0
        ;;
    refresh)
        check_root
        write_conf
        spoof_identity 0
        ;;
    spoof)
        check_root
        spoof_identity 0
        ;;
    watch)
        run_watcher
        ;;
    off)
        turn_off
        ;;
    lan-on)
        check_root
        echo on > "$LANSTATE"
        write_conf
        echo -e "${C_GREEN}[✓] Local LAN Access ENABLED${C_RESET} (10.0.0.0/8, 192.168.0.0/16, 172.16.0.0/12)"
        ;;
    lan-off)
        check_root
        echo off > "$LANSTATE"
        write_conf
        echo -e "${C_YELLOW}[!] Local LAN Access BLOCKED${C_RESET} (Strict VPN isolation)"
        ;;
    status)
        show_status "$2"
        ;;
    install)
        do_install
        ;;
    uninstall)
        do_uninstall
        ;;
    version|--version|-v)
        echo "Happ Kill Switch v${VERSION}"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        show_help
        exit 1
        ;;
esac
