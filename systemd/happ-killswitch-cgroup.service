[Unit]
Description=Happ VPN kill switch: cgroup outbound rule for happd.service
After=happd.service
Wants=happd.service
PartOf=happ-killswitch.service

[Service]
Type=oneshot
ExecCondition=/usr/sbin/nft list chain inet happkill happcgrp
# flush to avoid duplicate rules on restart
ExecStart=/bin/sh -c '/usr/sbin/nft flush chain inet happkill happcgrp && /usr/sbin/nft add rule inet happkill happcgrp socket cgroupv2 level 2 "system.slice/happd.service" accept'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
